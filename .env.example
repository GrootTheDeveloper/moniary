# Flutter client build defines. These are public client settings, not secrets.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase client configuration for FCM/APNs.
# Get these values from Firebase Console > Project settings > Your apps.
FIREBASE_ANDROID_API_KEY=AIzaSyDCak2yihz80CVs_3k1p86Nqeck7r9ZxZc
FIREBASE_IOS_API_KEY=AIzaSyB38TypjBqzTxZbrMzMn3o75OKBXpouDWk
FIREBASE_ANDROID_APP_ID=1:734508208267:android:bb246d1a3f2fd8cf5b048e
FIREBASE_IOS_APP_ID=1:734508208267:ios:97effaa38ebf7d625b048e
FIREBASE_MESSAGING_SENDER_ID=734508208267
FIREBASE_PROJECT_ID=moniary-6a8a7
FIREBASE_IOS_BUNDLE_ID=com.moniary.moniary

# Shared Azure OCR endpoint for team testing.
OCR_API_URL=https://ca-moniary-ocr-ocr-eo5b67.happydesert-5a5977c3.southeastasia.azurecontainerapps.io

# Local Supabase CLI migration connection string.
# Keep the real value in .env only; never commit it.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@your-pooler-host:6543/postgres

# Server-only Gemini configuration for assistant-chat and OCR enrichment.
# Set the real values separately in Supabase and the Azure OCR environment.
# For Supabase assistant-chat:
# supabase secrets set --env-file .env
GEMINI_API_KEY=your-rotated-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BLOCKED_KEY_SHA256=optional-comma-separated-sha256-digests-for-exposed-keys

# Supabase Edge Function secrets for push notifications.
ADMIN_NOTIFICATION_SECRET=use-a-long-random-admin-only-secret
NOTIFICATION_DISPATCH_SECRET=use-a-long-random-dispatch-secret
FCM_SERVICE_ACCOUNT_JSON={"project_id":"your-firebase-project","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
