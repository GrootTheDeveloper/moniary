# Public compile-time configuration for the Flutter app only.
# Never add DATABASE_URL, JWT_SECRET, SMTP passwords, or other server secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
OCR_API_URL=https://your-ocr-api.example.com

# Public Firebase iOS app identifiers from Firebase Console > Project settings.
# FIREBASE_APP_ID is platform-specific; use the iOS app ID for iPhone builds.
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_APP_ID=1:YOUR_SENDER_ID:ios:YOUR_IOS_APP_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_IOS_BUNDLE_ID=com.moniary.moniary

# Keep each button disabled until its provider is configured in Supabase.
ENABLE_GOOGLE_AUTH=true
ENABLE_FACEBOOK_AUTH=false

# Public Cloudflare Turnstile widget values. TURNSTILE_BASE_URL must use a
# hostname allowlisted on the Turnstile widget. Never put the secret key here.
TURNSTILE_SITE_KEY=YOUR_PUBLIC_TURNSTILE_SITE_KEY
TURNSTILE_BASE_URL=https://auth.example.com/
